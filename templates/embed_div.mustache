{{!
    @template mod_supervideo/embed_div

    Example context (json):
    {
      "elementid": "videoPlayer1",
      "videourl": "https://example.com/video.mp4",
      "autoplay": true,
      "showcontrols": false,
      "controls": "plat,pause",
      "speed": "1,1.5"
    }
}}

<div id="{{elementid}}"
     data-videourl="{{videourl}}"
     data-autoplay="{{autoplay}}"
     data-showcontrols="{{showcontrols}}"
     data-controls="{{controls}}"
     data-speed="{{speed}}"
     {{#hls}}
     data-hls-live="{{#str}} hls_live, mod_supervideo {{/str}}"
     data-hls-unknown="{{#str}} hls_unknown, mod_supervideo {{/str}}"
     data-hls-error="{{#str}} hls_error, mod_supervideo {{/str}}"
     data-hls-libraryerror="{{#str}} hls_libraryerror, mod_supervideo {{/str}}"
     data-hls-unsupported="{{#str}} hls_unsupported, mod_supervideo {{/str}}"
     data-hls-auto="{{#str}} hls_auto, mod_supervideo {{/str}}"
     {{/hls}}>
    {{#hls}}<p data-hls-status role="status" aria-live="polite" hidden></p>{{/hls}}
</div>
{{#hascaptions}}{{> mod_supervideo/transcript}}{{/hascaptions}}
