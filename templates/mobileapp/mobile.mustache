{{!
    @template mod_supervideo/mobileapp/mobile
    Native Moodle App player. Moodle renders alternate delimiters;
    Angular keeps its double-brace expressions.
}}
{{=<% %>=}}
<div class="mod-supervideo-mobile" id="mod-supervideo-mobile-<%cmid%>">
    <span core-site-plugins-call-ws-on-load
          name="mod_supervideo_get_playback_data"
          [params]="{cmid: <%cmid%>, supervideoid: <%supervideoid%>}"
          [preSets]="{getFromCache: 0, saveToCache: 0}"
          (onSuccess)="supervideoPlaybackLoaded($event)"
          (onError)="supervideoPlaybackError($event)"></span>

    <span core-site-plugins-call-ws-on-load
          name="mod_supervideo_view_supervideo"
          [params]="{supervideoid: <%supervideoid%>}"
          [preSets]="{getFromCache: 0, saveToCache: 0}"></span>

    <ion-item *ngIf="supervideoLoading" lines="none">
        <ion-spinner slot="start"></ion-spinner>
        <ion-label>{{ 'core.loading' | translate }}</ion-label>
    </ion-item>

    <ion-card *ngIf="supervideoError">
        <ion-card-content>{{ supervideoError }}</ion-card-content>
    </ion-card>

    <div class="mod-supervideo-mobile-player" *ngIf="supervideoData"
         style="width:100%; min-width:0; max-width:100%;">
        <video id="mod-supervideo-media-<%cmid%>"
               *ngIf="(supervideoData.content.type === 'file' || supervideoData.content.type === 'link') && !supervideoData.content.isaudio && !supervideoData.content.ishls"
               [src]="supervideoData.content.fileurl"
               core-external-content
               playsinline
               style="display:block; width:100%; max-width:100%; height:auto;"
               [attr.controls]="supervideoData.config.showcontrols ? '' : null"
               [attr.autoplay]="supervideoData.config.autoplay ? '' : null"></video>

        <video id="mod-supervideo-hls-<%cmid%>"
               *ngIf="supervideoData.content.ishls"
               playsinline
               style="display:block; width:100%; max-width:100%; height:auto;"
               [attr.controls]="supervideoData.config.showcontrols ? '' : null"
               [attr.autoplay]="supervideoData.config.autoplay ? '' : null"></video>

        <ion-card *ngIf="supervideoData.content.ishls && (supervideoHlsMode === 'live' || supervideoHlsMode === 'unknown')">
            <ion-card-content *ngIf="supervideoHlsMode === 'live'">
                {{ 'plugin.mod_supervideo.hls_live' | translate }}
            </ion-card-content>
            <ion-card-content *ngIf="supervideoHlsMode === 'unknown'">
                {{ 'plugin.mod_supervideo.hls_unknown' | translate }}
            </ion-card-content>
        </ion-card>
        <ion-card *ngIf="supervideoHlsError">
            <ion-card-content role="alert">{{ supervideoHlsError | translate }}</ion-card-content>
        </ion-card>

        <audio id="mod-supervideo-media-<%cmid%>"
               style="display:block; width:100%; max-width:100%;"
               *ngIf="(supervideoData.content.type === 'file' || supervideoData.content.type === 'link') && supervideoData.content.isaudio"
               [src]="supervideoData.content.fileurl"
               core-external-content
               [attr.controls]="supervideoData.config.showcontrols ? '' : null"
               [attr.autoplay]="supervideoData.config.autoplay ? '' : null"></audio>

        <div id="mod-supervideo-api-player-<%cmid%>"
             *ngIf="supervideoData.content.type === 'youtube'"
             [hidden]="supervideoYoutubeError"></div>

        <ion-card *ngIf="supervideoData.content.type === 'youtube' && supervideoYoutubeError">
            <ion-card-content>
                <p role="alert">{{ supervideoYoutubeError | translate }}</p>
                <p *ngIf="supervideoYoutubeBrowser">
                    {{ 'plugin.mod_supervideo.mobile_youtubebrowserhelp' | translate }}
                </p>
                <a *ngIf="supervideoYoutubeBrowser" core-link
                   href="<%activityurl%>" [capture]="false" [inApp]="false" autoLogin="check">
                    {{ 'plugin.mod_supervideo.mobile_openbrowser' | translate }}
                </a>
                <ion-button *ngIf="supervideoYoutubeRetry" expand="block" fill="clear"
                            (click)="supervideoRetryYoutube()">
                    {{ 'plugin.mod_supervideo.mobile_retry' | translate }}
                </ion-button>
            </ion-card-content>
        </ion-card>

        <core-iframe id="mod-supervideo-frame-<%cmid%>"
                     *ngIf="supervideoData.content.type !== 'file' && supervideoData.content.type !== 'link' && supervideoData.content.type !== 'youtube'"
                     [src]="supervideoData.content.fileurl"
                     [addSiteReferer]="true"></core-iframe>
    </div>

    <ion-item *ngIf="supervideoPercent !== null && supervideoData && supervideoData.config.showmap" lines="none">
        <ion-label>{{ supervideoPercent }}%</ion-label>
    </ion-item>
</div>
